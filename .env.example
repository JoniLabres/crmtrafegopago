# =====================================================
# GOOGLE TAG MANAGER
# =====================================================
GTM_ACCOUNT_ID=          # ID da conta GTM numérico (ex: 123456789)
GTM_CONTAINER_ID=        # ID do container GTM numérico (ex: 987654321)
GTM_PUBLIC_ID=           # Public ID do container (ex: GTM-XXXXXXX)
GTM_CREDENTIALS_JSON=    # Caminho para service account JSON com permissão Edit no GTM

# =====================================================
# GOOGLE ANALYTICS 4
# =====================================================
GA4_MEASUREMENT_ID=      # ID de medição GA4 (ex: G-XXXXXXXXXX)
GA4_PROPERTY_ID=         # ID numérico da propriedade GA4 (ex: 123456789)
GA4_API_SECRET=          # Secret para Measurement Protocol (servidor → GA4)
GA4_CREDENTIALS_JSON=    # Caminho para service account JSON com acesso Leitor à propriedade

# =====================================================
# META ADS — OAuth via Facebook Login
# =====================================================
META_CLIENT_ID=          # App ID (Facebook Developers → Configurações → Básico)
META_CLIENT_SECRET=      # App Secret (Facebook Developers → Configurações → Básico)
META_ACCESS_TOKEN=       # Preenchido automaticamente via OAuth
META_AD_ACCOUNT_ID=      # Preenchido automaticamente após seleção da conta
META_PIXEL_ID=           # ID do Pixel (opcional, padrão global)

# =====================================================
# GOOGLE ADS — OAuth via Google Cloud Console
# =====================================================
GOOGLE_ADS_CLIENT_ID=           # OAuth2 Client ID (Google Cloud Console)
GOOGLE_ADS_CLIENT_SECRET=       # OAuth2 Client Secret
GOOGLE_ADS_DEVELOPER_TOKEN=     # Developer Token (Google Ads → Central de APIs)
GOOGLE_ADS_REFRESH_TOKEN=       # Preenchido automaticamente via OAuth
GOOGLE_ADS_CUSTOMER_ID=         # Preenchido automaticamente após seleção da conta

# =====================================================
# LINKEDIN ADS — OAuth via LinkedIn Developer Portal
# =====================================================
LINKEDIN_CLIENT_ID=      # Client ID (LinkedIn Developer Portal)
LINKEDIN_CLIENT_SECRET=  # Client Secret
LINKEDIN_ACCESS_TOKEN=   # Preenchido automaticamente via OAuth
LINKEDIN_AD_ACCOUNT_ID=  # Preenchido automaticamente após seleção da conta
LINKEDIN_PARTNER_ID=     # ID do Insight Tag (aba Settings do app)

# =====================================================
# TIKTOK ADS — OAuth via TikTok for Business
# =====================================================
TIKTOK_CLIENT_ID=        # App ID (TikTok for Business Portal)
TIKTOK_CLIENT_SECRET=    # App Secret
TIKTOK_ACCESS_TOKEN=     # Preenchido automaticamente via OAuth
TIKTOK_AD_ACCOUNT_ID=    # Preenchido automaticamente após seleção da conta
TIKTOK_PIXEL_ID=         # ID do Pixel (TikTok Ads Manager → Eventos)
TIKTOK_SANDBOX=          # true em desenvolvimento, false em produção

# =====================================================
# SERVIDOR
# =====================================================
APP_BASE_URL=            # URL base pública do servidor (ex: https://app.ixctraffic.com.br)

# =====================================================
# HUBSPOT CRM
# =====================================================
HUBSPOT_API_KEY=         # Chave de API privada do HubSpot

# =====================================================
# DASHBOARD
# =====================================================
METABASE_URL=            # URL do Metabase (ex: https://metabase.suaempresa.com)
METABASE_TOKEN=          # Token de autenticação do Metabase

# =====================================================
# AGENTE DE IA
# =====================================================
ANTHROPIC_API_KEY=       # Chave de API da Anthropic (Claude)

# =====================================================
# ALERTAS
# =====================================================
SLACK_WEBHOOK_URL=       # Webhook URL do Slack para alertas

# =====================================================
# BANCO DE DADOS
# =====================================================
DATABASE_URL=            # URL PostgreSQL (ex: postgresql://user:pass@host:5432/dbname)
