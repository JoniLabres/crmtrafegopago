# =====================================================
# GOOGLE TAG MANAGER
# =====================================================
GTM_ACCOUNT_ID=          # ID da conta GTM (ex: 123456789)
GTM_CONTAINER_ID=        # ID do container GTM (ex: GTM-XXXXXXX)

# =====================================================
# GOOGLE ANALYTICS 4
# =====================================================
GA4_MEASUREMENT_ID=      # ID de medição GA4 (ex: G-XXXXXXXXXX)
GA4_API_SECRET=          # Secret para Measurement Protocol

# =====================================================
# META ADS
# =====================================================
META_ACCESS_TOKEN=       # Token de acesso da API do Meta
META_AD_ACCOUNT_ID=      # ID da conta de anúncios (ex: act_XXXXXXXXXX)

# =====================================================
# GOOGLE ADS
# =====================================================
GOOGLE_ADS_DEVELOPER_TOKEN=     # Developer token do Google Ads
GOOGLE_ADS_CUSTOMER_ID=         # ID do cliente Google Ads (ex: 123-456-7890)
GOOGLE_ADS_CLIENT_ID=           # OAuth2 Client ID
GOOGLE_ADS_CLIENT_SECRET=       # OAuth2 Client Secret
GOOGLE_ADS_REFRESH_TOKEN=       # OAuth2 Refresh Token

# =====================================================
# LINKEDIN ADS
# =====================================================
LINKEDIN_ACCESS_TOKEN=   # Token de acesso LinkedIn Marketing API
LINKEDIN_AD_ACCOUNT_ID=  # ID da conta de anúncios LinkedIn

# =====================================================
# TIKTOK ADS
# =====================================================
TIKTOK_ACCESS_TOKEN=     # Token de acesso TikTok Business API
TIKTOK_AD_ACCOUNT_ID=    # ID da conta de anúncios TikTok

# =====================================================
# HUBSPOT CRM
# =====================================================
HUBSPOT_API_KEY=         # Chave de API privada do HubSpot

# =====================================================
# DASHBOARD
# =====================================================
METABASE_URL=            # URL do Metabase (ex: https://metabase.suaempresa.com)
METABASE_TOKEN=          # Token de autenticação do Metabase

# =====================================================
# AGENTE DE IA
# =====================================================
ANTHROPIC_API_KEY=       # Chave de API da Anthropic (Claude)

# =====================================================
# ALERTAS
# =====================================================
SLACK_WEBHOOK_URL=       # Webhook URL do Slack para alertas

# =====================================================
# BANCO DE DADOS
# =====================================================
DATABASE_URL=            # URL PostgreSQL (ex: postgresql://user:pass@host:5432/dbname)
