{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 60 }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    { "path": "/api/pipeline/cron", "schedule": "0 11 * * *" },
    { "path": "/api/pipeline/cron", "schedule": "0 15 * * *" },
    { "path": "/api/pipeline/cron", "schedule": "0 18 * * *" },
    { "path": "/api/pipeline/cron", "schedule": "0 21 * * *" }
  ]
}
